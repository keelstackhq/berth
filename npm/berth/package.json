{
  "name": "@keelstackhq/berth",
  "version": "0.1.0",
  "description": "Give each parallel coding agent an isolated, ready workspace in a git repo (npm launcher for the berth binary)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keelstackhq/berth.git",
    "directory": "npm/berth"
  },
  "bin": {
    "berth": "bin/berth.js"
  },
  "files": [
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@keelstackhq/berth-linux-x64": "0.1.0",
    "@keelstackhq/berth-linux-arm64": "0.1.0",
    "@keelstackhq/berth-darwin-x64": "0.1.0",
    "@keelstackhq/berth-darwin-arm64": "0.1.0",
    "@keelstackhq/berth-win32-x64": "0.1.0"
  }
}
